{
  "expo": {
    "name": "Pokemon TCG Scanner",
    "slug": "pokemon-tcg-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "pokemon-tcg-scanner",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.pokemontcgscanner.app",
      "permissions": ["CAMERA"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Pokemon TCG Scanner to use the camera to scan cards."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
